APP_NAME="Tars Notificacoes"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tars_notificacoes
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

ADMIN_PASSWORD=change-this-password

# Seguranca de envio
# SMS_DRIVER e SMS_PROVIDER devem permanecer em mock nesta fase.
# SMS_ALLOW_REAL_SEND=false impede qualquer envio real.
# SMS_TEST_ONLY=true limita os destinatarios aos numeros listados em SMS_ALLOWED_TEST_PHONES.
# SMS_ALLOWED_TEST_PHONES aceita uma lista separada por virgula ou ponto e virgula.
# Os numeros podem vir com espacos, parenteses, hífen e +, pois serao normalizados pelo sistema.
SMS_PROVIDER=mock
SMS_DRIVER=mock
SMS_ALLOW_REAL_SEND=false
SMS_TEST_ONLY=false
SMS_ALLOWED_TEST_PHONES=
SMS_MAX_LENGTH=160
QUEUE_BATCH_SIZE=20
QUEUE_MAX_ATTEMPTS=3

# Integracao cliente com o gateway Tars Notificacoes
TARS_NOTIFICACOES_ENABLED=false
TARS_NOTIFICACOES_BASE_URL=https://gateway.tars.art.br
TARS_NOTIFICACOES_API_KEY=
TARS_NOTIFICACOES_TEST_PHONE=5549999999999
TARS_NOTIFICACOES_TIMEOUT=10

LOG_PATH=storage/logs
